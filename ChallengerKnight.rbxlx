						<Item class="LocalScript" referent="RBXC7F2E4A1CDF04CE88F3A96498724D7D5">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local StyleTracker = script.Parent.StyleTracker

local function checkChildrenCount()
	local children = {}
	for _, child in StyleTracker:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(children, child)
		end
	end
	if #children > 3 then
		children[1]:Destroy()
		print("DESTROYED")
	end
end


StyleTracker.ChildAdded:Connect(function()
	checkChildrenCount()
end)
]]></ProtectedString>
